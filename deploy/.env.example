# Copy to .env in the repository root and fill in. Never commit the real .env.

# Hostname the site is served on (its DNS must point at this server).
DOMAIN=tickets.example.com

# Generate each of these with:  openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Payments: "mock" (test mode) or "razorpay" (real money; needs the two keys below and a webhook
# pointing at https://<DOMAIN>/api/payments/webhook with the same PAYMENT_WEBHOOK_SECRET).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (verification, password reset, booking confirmations). Leave the host empty to only log emails.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
